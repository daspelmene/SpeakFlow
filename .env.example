# SpeakFlow — Environment Variables
# Copy this file to .env and fill in the values

# --- Database ---
POSTGRES_DB=speakflow
POSTGRES_USER=speakflow
POSTGRES_PASSWORD=<set a strong password here>

# --- JWT Authentication ---
JWT_SECRET_KEY=<set a strong secret key here>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Backend ---
API_BASE_URL=http://backend:8000/api/v1
DEEPSEEK_API_KEY=<paste your DeepSeek API key here>

# --- Next.js frontend ---
NEXT_PUBLIC_API_URL=http://backend:8000
NEXT_PUBLIC_WS_URL=ws://backend:8000
