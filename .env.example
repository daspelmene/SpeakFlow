# SpeakFlow — Environment Variables
# Copy this file to .env and fill in the values

# --- Database ---
POSTGRES_DB=speakflow
POSTGRES_USER=speakflow
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- WebRTC (Docker networking) ---
# Replace container-internal IP in SDP/ICE candidates with a reachable IP.
# For local Docker on macOS/Linux: 127.0.0.1
# For VM deploy: the VM's public IP
WEBRTC_HOST_IP=127.0.0.1

# Constrain aiortc UDP port range (must match the mapped ports in docker-compose)
AIOICE_MIN_PORT=10000
AIOICE_MAX_PORT=10100

# --- Caddy reverse-proxy ---
# Domain or IP:port for Caddy. Examples:
#   :80                      (HTTP, local dev)
#   :8443                    (HTTPS with self-signed cert, testing)
#   speakflow.example.com    (HTTPS with Let's Encrypt, production)
HOST=:80

# HTTP port for Caddy (default: 80)
CADDY_HTTP_PORT=80
# HTTPS port for Caddy (default: 443)
CADDY_HTTPS_PORT=443

# --- Next.js frontend ---
# Direct WebSocket URL (empty = use Caddy proxy).
# Set this ONLY if you access Next.js directly (port 3000) instead of Caddy:
#   NEXT_PUBLIC_WS_URL=ws://localhost:8000
# When using Caddy (recommended), leave this EMPTY.
NEXT_PUBLIC_WS_URL=
